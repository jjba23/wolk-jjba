  "description": "Logs of every Shepherd (herd) daemon and every routed syslog file. Alloy tails /var/log/wolk-jjba/*.log and /var/log/*.log, derives the `service` label from the file name and pushes the lines to Loki.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Everything Alloy ships, newest first. Pick one or more daemons in the `daemon` selector to narrow every panel. Click a line to open it in Explore.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"host\", service=~\"$daemon\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "All daemon logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Lines per daemon. A flat line means the daemon is quiet, not necessarily healthy; a gap usually means it was restarted or stopped.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
